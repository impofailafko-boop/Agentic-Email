# Database Configuration
DB_PATH=./emails.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/agentic_email

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Email Configuration (SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Security & Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY_SALT=your-api-key-salt-change-this-in-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# LinkedIn API (when implemented)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# News APIs (when implemented)
NEWS_API_KEY=your-news-api-key

# Application Configuration
PORT=3000
NODE_ENV=development

# Monitoring (optional)
SENTRY_DSN=https://your-sentry-dsn
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Feature Flags
ENABLE_AB_TESTING=true
ENABLE_ML_PREDICTIONS=true
ENABLE_LINKEDIN_INTEGRATION=false
ENABLE_NEWS_INTEGRATION=false
